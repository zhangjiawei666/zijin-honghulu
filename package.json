{
  "name": "stock-monitor-agent",
  "version": "1.2.3",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "bundle:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/server.cjs",
    "build:mobile": "tsc -b && vite build && esbuild server/mobile.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/mobile-server.cjs",
    "start:mobile": "node dist-server/mobile-server.cjs",
    "build:win7": "tsc -b && vite build && esbuild server/win7.ts --bundle --platform=node --format=cjs --target=node16 --outfile=dist-server/win7-server.cjs",
    "dist": "npm run build && npm run bundle:server && electron-builder --win portable --x64",
    "dist:win7": "npm run build:win7 && electron-builder --config electron-builder-win7.json --win portable --x64"
  },
  "build": {
    "appId": "com.workbuddy.stockmonitor",
    "productName": "紫金红葫芦",
    "copyright": "WorkBuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "自选股行情监控-${version}-${arch}.exe"
    },
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false
  },
  "dependencies": {
    "@tdesign-react/aigc": "^0.1.0-alpha.1",
    "@tdesign-react/chat": "^1.0.2",
    "@tencent-ai/agent-sdk": "^0.3.43",
    "express": "^4.18.2",
    "lucide-react": "^0.563.0",
    "markdown-it": "^14.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "22.3.27",
    "electron-builder": "^26.15.3",
    "less": "^4.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.10"
  }
}
