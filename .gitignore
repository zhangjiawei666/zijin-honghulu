# 依赖
node_modules/
.pnpm-store/

# 构建产物（可由 npm run build / build:mobile / bundle:server 重新生成）
dist/
dist-server/
dist-mobile/

# TypeScript 增量编译缓存
*.tsbuildinfo
tsconfig.node.tsbuildinfo
tsconfig.tsbuildinfo

# 发布产物（体积大，通过 GitHub Releases 分发而非入库）
release/
release-formal/
release-win7/
*.zip

# 运行时数据
data/
*.db
*.db-shm
*.db-wal

# 日志与临时文件
*.log
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vite/
*.timestamp-*.mjs

# 环境变量（含密钥，禁止入库）
.env
.env.local
.env.*.local

# 编辑器 / 系统
.vscode/
.idea/
*.swp
