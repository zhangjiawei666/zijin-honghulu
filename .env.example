# ============ CodeBuddy Agent SDK 配置 ============
# 方式一：API Key（推荐）
# 从 https://www.codebuddy.cn 获取
CODEBUDDY_API_KEY=

# 方式二：Auth Token（使用 CodeBuddy CLI 登录后生成）
# CODEBUDDY_AUTH_TOKEN=

# 网络环境：production（默认）/ staging
# CODEBUDDY_INTERNET_ENVIRONMENT=production

# 自定义服务地址（可选）
# CODEBUDDY_BASE_URL=

# ============ 行情监控配置 ============
# 监控 Agent 使用的模型
CODEBUDDY_MODEL=claude-sonnet-4

# ============ 服务器配置 ============
PORT=3000
